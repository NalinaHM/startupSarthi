# Copy to .env in the project root. Restart `npm run dev` after changes.

# Used locally by Vite dev proxy AND on Vercel by /api/analyze serverless function:
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_MODEL=gemini-2.5-flash

# Only needed when building an Android APK/AAB with Capacitor so the mobile app calls your live Vercel backend:
# VITE_API_BASE_URL=https://your-app-name.vercel.app
